{
  "name": "Enfermería Roxy",
  "short_name": "Enf. Roxy",
  "description": "Buscador y clasificador de apuntes de Enfermería conectado a Google Drive.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FCF1F5",
  "theme_color": "#D9688F",
  "lang": "es",
  "icons": [
    { "src": "/icon.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["*/*"] }
      ]
    }
  }
}
